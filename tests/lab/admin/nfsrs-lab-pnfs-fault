#!/usr/bin/env bash
set -euo pipefail

action="${1:?action required}"
run_id="${2:?run id required}"
runner_ip=10.131.9.11
ds_ip=10.128.56.161
mds_ip=10.128.56.160
state_file=/run/nfsrs-lab-pnfs-fault.run-id
table=nfsrs_pnfs_fault

[[ "$run_id" =~ ^(nightly|release)-[A-Za-z0-9._-]{1,80}$ ]] || {
  echo "unsafe run id: $run_id" >&2
  exit 2
}
ip -o -4 addr show | grep -Fq " $runner_ip/" || {
  echo "refusing pNFS fault outside the authorized runner" >&2
  exit 2
}

restore() {
  nft list table inet "$table" >/dev/null 2>&1 && nft delete table inet "$table"
  rm -f "$state_file"
}

case "$action" in
  isolate-ds|isolate-mds)
    target=ds
    target_ip="$ds_ip"
    [[ "$action" == isolate-mds ]] && target=mds && target_ip="$mds_ip"
    if [[ -e "$state_file" ]]; then
      read -r owner_run owner_target <"$state_file"
      [[ "$owner_run" == "$run_id" && "${owner_target:-ds}" == "$target" ]] || {
        echo "pNFS fault belongs to a different run" >&2
        exit 2
      }
      echo "pNFS $target already isolated for $run_id"
      exit 0
    fi
    nft add table inet "$table"
    nft "add chain inet $table output { type filter hook output priority -10; policy accept; }"
    nft add rule inet "$table" output ip daddr "$target_ip" tcp dport 2049 drop
    printf '%s %s\n' "$run_id" "$target" >"$state_file"
    ss -K dst "$target_ip" dport = :2049 >/dev/null 2>&1 || true
    echo "pNFS $target isolated for $run_id"
    ;;
  restore-ds|restore-mds)
    if [[ -e "$state_file" ]]; then
      read -r owner_run _ <"$state_file"
      [[ "$owner_run" == "$run_id" ]] || {
        echo "pNFS fault belongs to a different run" >&2
        exit 2
      }
    fi
    restore
    echo "pNFS endpoint restored for $run_id"
    ;;
  status)
    if nft list table inet "$table" >/dev/null 2>&1; then
      printf 'isolated %s\n' "$(<"$state_file")"
    else
      echo 'restored'
    fi
    ;;
  *)
    echo "unsupported action: $action" >&2
    exit 2
    ;;
esac
