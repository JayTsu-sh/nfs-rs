LAB_SSH_USER=ci-runner
LAB_SSH_KEY=/home/github-runner/.ssh/terrasync_lab
LAB_SOURCE_MGMT=10.131.9.12
LAB_DEST_MGMT=10.131.9.13
LAB_WORKER_MGMT=10.131.9.14
LAB_SOURCE_DATA=10.10.1.12
LAB_DEST_DATA=10.10.1.13
LAB_WORKER_DATA=10.10.1.14
LAB_NFS3_EXPORT=/srv/nfs/v3
LAB_NFS41_EXPORT=/srv/nfs/v4
# NetApp ONTAP 9.19.1, SVM Test-y. Management credentials are intentionally
# excluded; nightly uses only the NFS data LIFs and dedicated NFSv4 exports.
LAB_PNFS_MDS_DATA=10.128.56.160
LAB_PNFS_DS_DATA=10.128.56.161
LAB_PNFS_PRIMARY_EXPORT=/nfsrs_pnfs_a
LAB_PNFS_SECONDARY_EXPORT=/nfsrs_pnfs_b
# OTS pNFS is the benchmark-suite pNFS environment (manifest entries
# ots-pnfs-mds / ots-pnfs-ds with an `executor` marker). Its 10.30.3.0/24
# data network is unreachable from the runner; acquisition runs from
# 10.128.135.141 through 10.128.134.90 (10.30.3.154:/nfsrs_pnfs_a MDS,
# 10.30.3.155:/nfsrs_pnfs_b DS). The LAB_PNFS_* values above still point at
# the retired legacy cluster, the interim physical target of the
# runner-side NFSv4.1 compatibility, channel-limit, and pNFS-client E2E
# steps, and move to OTS together with the OTS executor wiring.
# OTS pNFS executor (current pNFS storage; the AFX svm2 environment was
# decommissioned 2026-11-24, jump 10.128.56.17). The 10.30.3.0/24 data
# network is unreachable from the runner, so pNFS cases run on the DXN
# executor node through the management jump; both hops authenticate with the
# same key.
LAB_OTS_PNFS_DATA=10.30.3.154
LAB_OTS_PNFS_EXPORT=/nfsrs_pnfs_a
LAB_OTS_JUMP=10.128.134.90
LAB_OTS_NODE=10.128.135.141
LAB_OTS_SSH_USER=root
# LAB_OTS_SSH_KEY / LAB_OTS_KNOWN_HOSTS are provisioned per run by the
# "Prepare OTS pNFS executor SSH credentials" workflow step (secret
# NFS_RS_OTS_SSH_KEY) and must not be stored here.
LAB_OTS_EXECUTOR_PYTHON=/opt/nfsrs-executor/python3.11/bin/python3.11
LAB_SOURCE_S3=http://10.10.1.12:9000
LAB_DEST_S3=http://10.10.1.13:9000
LAB_WORKER_S3=http://10.10.1.14:9000
